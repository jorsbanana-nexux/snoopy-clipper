# === WAJIB ===
GEMINI_API_KEY=your_key_here

# === OTAK ===
GEMINI_MODEL=gemini-3.1-pro-preview  # model TERTINGGI duluan (pro preview)

# Rantai fallback: model utama dicoba GEMINI_PRIMARY_RETRIES kali, kalau tetap
# gagal (503 high demand / rate limit / error server) turun ke daftar cadangan
# di bawah, satu per satu, sampai ada yang lolos.
GEMINI_PRIMARY_RETRIES=2
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-2.5-flash  # urutan TURUN (gemini-2.5-pro DIBUANG: Google sudah mematikannya, 404 permanen)
GEMINI_RETRY_DELAY_SEC=2.0

# === OUTPUT ===
# kosong = auto (1080x1920 kalau sumber cukup, kalau tidak 720x1280). Bisa: 1080 / 720
FORCE_RESOLUTION=
MAX_SOURCE_HEIGHT=1080

# ============ STRATEGI CEPAT ============
# 1 = transkrip bawaan platform (instan) utk otak + unduh video HANYA rentang terpilih.
# 0 = jalur klasik: unduh penuh + whisper penuh (lebih lambat).
CAPTIONS_FIRST=1
# Video lebih panjang dari ini (detik): analisis visual frame dilewati di jalur cepat.
# Default 240 agar caption-first tidak diam-diam mengunduh video panjang penuh.
BRAIN_FRAMES_MAX_DURATION=240

# Otak MELIHAT video panjang juga: proxy visual murah (kualitas terburuk, tanpa
# audio, ~15-40MB/jam) diunduh SEKALI per video lalu frame diekstrak utk Gemini.
# 1 = aktif (rekomendasi — otak tidak buta di podcast panjang); 0 = teks saja.
BRAIN_FRAMES_PROXY=1

# === WHISPER ===
WHISPER_MODEL=small
WHISPER_BEAM=1  # 1 = tercepat, ketepatan waktu kata tetap presisi; 5 = anti-typo maksimal (lebih lambat)
WHISPER_COMPUTE=int8

# === MOMEN ===
MAX_CLIPS=100  # plafon pengaman saja — jumlah klip ditentukan otak AI sesuai kualitas video
MIN_CLIP_SEC=15
MAX_CLIP_SEC=90

# === SPEED (PC low-spec) ===
FACE_SAMPLE_INTERVAL=1.0
LEAD_AHEAD_SEC=2.0

# === MOTION BLUR ala game (halus, aktif hanya saat kamera pan) ===
MOTION_BLUR=1
MOTION_BLUR_STRENGTH=0.35

# === GRADE "GAME ULTRA" (texture/shadow/warna/kulit hangat; murah, benchmark) ===
GAME_ULTRA=0  # efek game tetap jalan; 1 = grade paling rame tapi render +40%

# === BGM VIRAL (Kevin MacLeod / incompetech, CC BY 4.0) ===
# Otak pilih mood di panggilan Gemini yang sama (nol biaya tambahan).
# Track diunduh SEKALI per track lalu cache permanen (mono 64k, ~0.5-1.5MB).
# Mood WAJIB selalu ada — tidak ada klip tanpa BGM. Kredit di description.txt.
BGM=1
BGM_VOLUME=0.15  # intensitas kecil & nyaman (15% dari suara utama)

# === PEMBICARA AKTIF (dukungan 2..10+ orang; anti kacau) ===
# Ganti fokus hanya jika pembicara baru MENAHAN bicara >= SPEAKER_SWITCH_SEC
# -> balasan singkat "oke"/"ya" diabaikan, kamera tenang & mulus.
SPEAKER_SWITCH_SEC=1.5
SPEAKER_DOMINANCE=1.4  # bicara serempak: pindah hanya kalau jelas dominan 1.4x
SPEAKER_HOLD_SEC=2.0  # tenang minimal sesudah pindah fokus (serempak tak flip-flop)

# === URL CHANNEL/PROFILE (auto-deteksi semua platform) ===
# Tempel link channel/profile/playlist -> video terbaik dipilih otomatis
# dari kandidat terbaru (diperhitungkan: views x durasi x posisi, bukan random)
CHANNEL_MAX_CANDIDATES=60
UNSHARP_AMOUNT=0.45
EQ_CONTRAST=1.06
EQ_GAMMA=0.94
EQ_SATURATION=1.12
WARM_HUE_DEG=2.0

# === SUBTITLE (ala clipper premium: Komika Axis, huruf besar di awal, teks bersih) ===
SUBTITLE_FONT=Komika Axis
SUBTITLE_CASE=title
SUBTITLE_SIZE_FRAC=0.048
SUBTITLE_Y_FRAC=0.70
SUBTITLE_POP=1.18
SUBTITLE_POP_MS=80
HIGHLIGHT_COLOR=FFAA00
KARAOKE_FADE_MS=70

# KARAOKE STABILO: kata aktif biru saat diucapkan -> putih setelahnya (tiap kata, terus-menerus)

# === SMART PLACEMENT (anti tabrakan wajah/UI/teks-bawaan + saliency) ===
PLACEMENT_SMART=1
UI_SAFE_RIGHT=0.12
UI_SAFE_BOTTOM=0.15
SUBTITLE_MIN_Y_FRAC=0.18

# === OTAK MULTIMODAL (Gemini melihat cuplikan frame) ===
BRAIN_MULTIMODAL=1
BRAIN_FRAME_INTERVAL=8
BRAIN_MAX_FRAMES=48
X264_PRESET=veryfast
X264_CRF=20

# ================= SIAP-PRODUK =================
# Kunci akses API — KOSONGKAN utk mode lokal biasa (semua request bebas).
# ISI saat hosting publik/VPS: semua /api/clip, /api/jobs, /api/library butuh
# header X-API-Key (frontend otomatis minta kunci ke pengguna).
# Contoh: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
API_KEY=

# Batas menit video per hari (reset 00:00 UTC). 0 = tanpa batas.
# Fondasi billing: isi saat server dipakai orang lain.
DAILY_MINUTES_LIMIT=0

# ================= AUTO-POST: YOUTUBE SHORTS =================
# Daftar: console.cloud.google.com -> project baru -> aktifkan "YouTube Data API v3"
# -> OAuth consent screen (External, test user = akunmu) -> Credentials -> OAuth
# client ID (Web application) -> redirect URI: http://localhost:8000/api/publish/callback
# (hosting publik? tambahkan juga https://domainmu/api/publish/callback)
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REDIRECT_URI=http://localhost:8000/api/publish/callback
PUBLISH_PRIVACY=public

# ============ MULTI-USER & BILLING (gap #6 — default NONAKTIF) ============
# MULTIUSER=1 mengaktifkan: registrasi/login akun + kunci API per-user,
# kuota per plan, halaman login otomatis di UI, endpoint billing.
# Saat MULTIUSER=1 biarkan API_KEY KOSONG (auth per-user yang berlaku).
MULTIUSER=0
PLAN_FREE_DAILY_MINUTES=30
PLAN_PRO_DAILY_MINUTES=240
PLAN_PRO_PRICE_IDR=39000
# Email akun admin (bisa grant plan manual: POST /api/billing/grant)
ADMIN_EMAIL=
# Midtrans (opsional). TANPA ini checkout otomatis mode MANUAL:
# order dibuat -> pembeli transfer bank -> admin grant. Jualan tanpa gateway.
# Server key sandbox di dashboard Midtrans berawalan "SB-Mid-server-".
# Webhook URL (daftarkan di dashboard Midtrans): https://domainmu/api/billing/midtrans-webhook
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=0
